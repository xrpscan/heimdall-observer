{
  "database": {
    "filePath": "./data/observer.db"
  },
  "httpServer": {
    "addr": "localhost:8080",
    "allowedOrigins": ["*"],
    "corsMaxAgeSec": 86400
  },
  "logger": {
    "filePath": "./logs/observer.log",
    "level": "debug",
    "pretty": true
  },
  "ripple": {
    "addr": "wss://xrplcluster.com"
  },
  "validationStream": {
    "maxBatchSize": 50,
    "autoFlushDelaySec": 30
  }
}
