{
  "database": {
    "filePath": "./data/observer.db"
  },
  "httpServer": {
    "addr": "localhost:8080",
    "allowedOrigins": ["*"],
    "corsMaxAgeSec": 86400
  },
  "kafka": {
    "brokers": ["localhost:19092", "localhost:29092", "localhost:39092"],
    "username": "something",
    "password": "secret",
    "caCertPath": "/path/to/ca/cert",
    "validationsTopic": "your-validations-topic",
    "ledgerTopic": "your-ledger-topic"
  },
  "logger": {
    "filePath": "./logs/observer.log",
    "level": "debug",
    "pretty": true
  },
  "xrpl": {
    "addr": "wss://xrplcluster.com"
  },
  "validationStreamProcessor": {
    "maxBatchSize": 50,
    "autoFlushDelaySec": 10
  },
  "ledgerStreamProcessor": {
    "maxBatchSize": 1,
    "autoFlushDelaySec": 10
  },
  "validationKafkaSynchronizer": {
    "maxBatchSize": 50,
    "pollIntervalSec": 1
  },
  "ledgerKafkaSynchronizer": {
    "maxBatchSize": 4,
    "pollIntervalSec": 10
  }
}
